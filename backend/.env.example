# Copy to .env and fill in your values
# Use the IPv4 transaction pooler (port 6543) if your network can't reach IPv6.
# URL-encode any special chars in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.PROJECTREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
CORS_ORIGINS=["http://localhost:3000"]